---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import { PetService } from '../../services/pet-service.js';
import { users } from '../../lib/data.js';
import { generateEdition } from '../../data/journey.js';

export const prerender = false;

const { slug } = Astro.params;
if (!slug) return Astro.redirect('/');

const pet = await PetService.getPetBySlug(slug);
if (!pet) return Astro.redirect('/');

const viewer = Astro.locals.user;
const isOwner = !!viewer && viewer.id === pet.userId;

// Privacidade configurável: jornal privado só é visível para o dono.
const isPrivateBlocked = pet.journalVisibility === 'private' && !isOwner;

// Dia da jornada vive no perfil do DONO. Visualização do dono avança no máx. 1x/dia.
let journeyDay = 1;
if (!isPrivateBlocked) {
  if (isOwner) {
    const { data } = await users.advanceJourneyDay(viewer.id, { cap: true });
    journeyDay = data?.journeyDay ?? 1;
  } else {
    const { data: owner } = await users.findById(pet.userId);
    journeyDay = owner?.journeyDay ?? 1;
  }
}

const edition = isPrivateBlocked ? null : generateEdition(pet, journeyDay);

const today = new Date();
const formattedDate = today.toLocaleDateString('pt-BR', {
  weekday: 'long', day: '2-digit', month: 'long', year: 'numeric',
}).toUpperCase();

const pageTitle = `${pet.name} — Edição do Dia | Notícias do Céu`;
const pageDescription = `A edição diária do jornal celestial de ${pet.name}. Histórias do paraíso, renovadas a cada dia.`;
const ogImage = pet.photos && pet.photos.length > 0 ? pet.photos[0] : 'https://noticias-do-ceu.com/og-image-default.png';
---

<Layout title={pageTitle} description={pageDescription} ogImage={ogImage} ogType="article" robots="noindex, follow">
  <Navbar showCreateMemorial={false} />

  <main class="flex-grow pt-32 pb-20 bg-gradient-to-b from-paper/30 to-white text-ink">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">

      {isPrivateBlocked ? (
        <div class="newspaper-container border-double-thick p-8 bg-white text-center max-w-2xl mx-auto">
          <i class="fa-solid fa-lock text-accent text-4xl mb-4"></i>
          <h1 class="font-serif text-2xl font-black uppercase text-ink mb-2">Jornal Privado</h1>
          <p class="text-sm text-gray-600 font-body max-w-md mx-auto">
            A edição de {pet.name} está configurada como privada. Apenas a família responsável,
            quando conectada à sua conta, pode acessar este jornal.
          </p>
          <a href="/" class="mt-6 inline-flex items-center gap-2 bg-ink text-paper px-6 py-2.5 rounded-full font-serif font-bold text-sm hover:bg-accent transition-colors">
            <i class="fa-solid fa-house"></i> Voltar ao Início
          </a>
        </div>
      ) : (
        <Fragment>
          <!-- THE NEWSPAPER -->
          <div class="newspaper-container border-double-thick p-4 sm:p-8" id="newspaper-paper">
            <!-- Header -->
            <header class="text-center mb-6">
              <div class="flex justify-between items-center border-y-newspaper py-2 mb-4">
                <div class="text-xs sm:text-sm font-bold uppercase w-1/3 text-left">
                  <i class="fa-solid fa-cloud text-accent"></i> Edição Diária
                </div>
                <div class="text-xs sm:text-sm font-bold uppercase w-1/3 text-center tracking-widest text-accent">
                  Amor Eterno
                </div>
                <div class="text-xs sm:text-sm font-bold uppercase w-1/3 text-right">
                  {formattedDate}
                </div>
              </div>

              <p class="font-serif text-3xl sm:text-5xl font-black uppercase tracking-tighter mb-2 text-ink" style="text-shadow: 2px 2px 0px rgba(0, 0, 0, 0.1)">
                Notícias do Céu
              </p>
              <p class="font-serif text-sm sm:text-base italic mb-4">
                O JORNAL DIÁRIO DE {pet.name.toUpperCase()}
              </p>

              <div class="border-y-newspaper py-1 mb-6 text-xs font-bold uppercase tracking-widest">
                DIRETAMENTE DO PARAÍSO PARA A TERRA • EDIÇÃO Nº {edition.day}
              </div>
            </header>

            <!-- Day Badge -->
            <div class="flex justify-center mb-6">
              <div class="inline-flex items-center gap-3 bg-accent/10 border border-accent/20 rounded-2xl px-6 py-2.5">
                <i class={`fa-solid ${edition.icon} text-accent text-xl`}></i>
                <div class="text-left">
                  <p class="text-[10px] font-bold uppercase tracking-widest text-accent leading-none">
                    {edition.isChronicle ? 'Crônica do Paraíso' : 'Jornada Celestial'}
                  </p>
                  <p class="font-serif text-xl font-black text-ink leading-tight">Dia {edition.day}</p>
                </div>
              </div>
            </div>

            <!-- Content Grid -->
            <div class="grid grid-cols-1 md:grid-cols-12 gap-6">
              <!-- Sidebar -->
              <div class="md:col-span-3 border-b-2 md:border-b-0 md:border-r-2 border-ink/30 pb-6 md:pb-0 md:pr-6">
                <div class="text-center mb-4">
                  <h5 class="font-serif font-bold text-lg uppercase mb-2 flex items-center justify-center gap-2">
                    <i class={`fa-solid ${edition.sidebarTop.icon} text-accent`}></i>
                    <span>{edition.sidebarTop.title}</span>
                  </h5>
                  <div set:html={edition.sidebarTop.contentHtml} />
                </div>
                <div class="separator-line"></div>
                <div class="text-center mt-4">
                  <h5 class="font-serif font-bold text-lg uppercase mb-2 flex items-center justify-center gap-2">
                    <i class={`fa-solid ${edition.sidebarBottom.icon} text-accent`}></i>
                    <span>{edition.sidebarBottom.title}</span>
                  </h5>
                  <div set:html={edition.sidebarBottom.contentHtml} />
                </div>
              </div>

              <!-- Main Article -->
              <div class="md:col-span-9">
                <div class="text-center mb-6">
                  <h2 class="font-serif font-bold text-3xl uppercase leading-none mb-3">{edition.headline}</h2>
                  <h3 class="font-serif text-xl font-medium italic text-gray-700 mb-4">{edition.subheadline}</h3>
                </div>

                <div class="flex flex-col sm:flex-row gap-6 items-start">
                  {edition.image && (
                    <div class="w-full sm:w-1/2 relative">
                      <div class="absolute -top-3 -left-3 text-4xl text-accent/80">
                        <i class="fa-solid fa-quote-left"></i>
                      </div>
                      <div class="border-4 border-white shadow-md transform -rotate-2 relative z-10">
                        <img
                          src={edition.image}
                          alt={edition.imageAlt}
                          class="w-full h-auto object-cover filter grayscale contrast-[1.1]"
                        />
                        <div class="absolute bottom-0 w-full bg-black/60 text-white text-xs p-1 text-center font-serif">
                          {edition.caption}
                        </div>
                      </div>
                    </div>
                  )}

                  <div class={`w-full ${edition.image ? 'sm:w-1/2' : ''} text-left md:text-justify font-body text-sm sm:text-base`}>
                    {edition.paragraphsHtml.map((p) => <div set:html={p} />)}
                    <p class="font-bold font-serif text-center mt-4 text-accent border-t border-ink/20 pt-4">
                      {edition.pullQuote}
                    </p>
                  </div>
                </div>
              </div>
            </div>

            <!-- Footer -->
            <footer class="mt-8 pt-4 border-t-2 border-ink text-center">
              <p class="font-serif text-sm font-bold uppercase tracking-widest flex items-center justify-center gap-4">
                <i class="fa-solid fa-star text-accent"></i>
                Porque o amor verdadeiro não tem fim
                <i class="fa-solid fa-star text-accent"></i>
              </p>
            </footer>
          </div>

          {/* TODO TESTE: botão temporário para avançar o dia manualmente. Remover depois. */}
          {isOwner && (
            <div class="mt-6 text-center">
              <button
                id="next-day-btn"
                type="button"
                class="inline-flex items-center gap-2 bg-ink text-paper px-6 py-3 rounded-full font-serif font-bold text-sm hover:bg-accent transition-colors shadow-md disabled:opacity-50"
              >
                Próxima edição (teste) <i class="fa-solid fa-arrow-right text-xs"></i>
              </button>
              <p class="text-[11px] text-gray-400 mt-2 font-body">Botão de teste — avança o dia da jornada manualmente.</p>
            </div>
          )}
        </Fragment>
      )}
    </div>
  </main>

  <Footer />

  <script is:inline>
    // TODO TESTE: remover junto com o botão "Próxima edição (teste)".
    (function () {
      const btn = document.getElementById('next-day-btn');
      if (!btn) return;
      btn.addEventListener('click', async () => {
        btn.disabled = true;
        try {
          const res = await fetch('/api/pet/next-day', { method: 'POST' });
          if (!res.ok) throw new Error('Falha ao avançar o dia.');
          window.location.reload();
        } catch (e) {
          alert('Não foi possível avançar para a próxima edição.');
          btn.disabled = false;
        }
      });
    })();
  </script>
</Layout>
