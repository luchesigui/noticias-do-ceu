---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import { db } from '../../db/index.js';
import { pets as petsTable } from '../../db/schema.js';
import { eq } from 'drizzle-orm';
import { users as usersApi } from '../../lib/data.js';
import { generateProceduralEdition } from '../../data/procedural-stories.js';

export const prerender = false;

// 1. Authenticate user
const user = Astro.locals.user;
if (!user) {
  return Astro.redirect('/login');
}

if (user.status === 'pending_payment') {
  return Astro.redirect('/checkout');
}

// 2. Fetch and validate pet
const { petId } = Astro.params;
if (!petId) {
  return Astro.redirect('/dashboard');
}

const rows = await db.select().from(petsTable).where(eq(petsTable.id, petId)).limit(1);
const pet = rows[0];

if (!pet) {
  return Astro.redirect('/dashboard');
}

// Security check: ensure user owns this pet
if (pet.userId !== user.id) {
  return Astro.redirect('/dashboard');
}

// Parse pet lists
const parsedPet = {
  ...pet,
  nicknames: typeof pet.nicknames === 'string' ? JSON.parse(pet.nicknames) : (pet.nicknames || []),
  personalities: typeof pet.personalities === 'string' ? JSON.parse(pet.personalities) : (pet.personalities || []),
  photos: typeof pet.photos === 'string' ? JSON.parse(pet.photos) : (pet.photos || []),
};

// 3. Timezone-aware local date helper
function getLocalDateString() {
  const options = { timeZone: 'America/Sao_Paulo', year: 'numeric', month: '2-digit', day: '2-digit' };
  const formatter = new Intl.DateTimeFormat('pt-BR', options);
  const [{ value: day },,{ value: month },,{ value: year }] = formatter.formatToParts(new Date());
  return `${year}-${month}-${day}`;
}

const todayStr = getLocalDateString();
let currentJourneyDay = user.journeyDay;

// 4. Handle test action (POST) to advance the day manually
if (Astro.request.method === 'POST') {
  const formData = await Astro.request.formData();
  const action = formData.get('action');
  
  if (action === 'next-day') {
    const nextDay = user.journeyDay + 1;
    await usersApi.update(user.id, {
      journeyDay: nextDay,
      lastJourneyIncrementAt: todayStr
    });
    return Astro.redirect(`/${petId}/jornal`);
  }
}

// 5. Automatic increment check (GET path)
if (user.lastJourneyIncrementAt !== todayStr) {
  let updatedDay = user.journeyDay;
  if (!user.lastJourneyIncrementAt) {
    // First time viewing the newspaper: set to Day 1
    updatedDay = 1;
    await usersApi.update(user.id, {
      lastJourneyIncrementAt: todayStr,
      journeyDay: 1
    });
  } else {
    // Subsequent days: increment by 1
    updatedDay = user.journeyDay + 1;
    await usersApi.update(user.id, {
      lastJourneyIncrementAt: todayStr,
      journeyDay: updatedDay
    });
  }
  currentJourneyDay = updatedDay;
}

// 6. Generate the procedural newspaper edition for today
const news = generateProceduralEdition(parsedPet, currentJourneyDay);

// Pick a photo randomly if they exist
let selectedPhoto = null;
if (parsedPet.photos && parsedPet.photos.length > 0) {
  const randomIndex = Math.floor(Math.random() * parsedPet.photos.length);
  selectedPhoto = parsedPet.photos[randomIndex];
}

// Format today's date for the newspaper header
const targetDate = new Date();
const dateOptions = { day: "numeric", month: "long", year: "numeric" };
let formattedDate = targetDate.toLocaleDateString("pt-BR", dateOptions);
formattedDate = formattedDate.charAt(0).toUpperCase() + formattedDate.slice(1);
---

<Layout title={`Notícias do Céu | Edição de ${parsedPet.name}`}>
  <Navbar showCreateMemorial={false} />

  <main class="flex-grow pt-32 pb-20 bg-gradient-to-b from-paper/30 to-white text-ink">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Top controls & info outside the newspaper -->
      <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-6 border-b border-gray-200 pb-4">
        <div>
          <a href="/dashboard" class="inline-flex items-center gap-1.5 text-xs font-bold uppercase tracking-wider text-accent hover:text-ink transition-colors">
            <i class="fa-solid fa-arrow-left"></i> Voltar ao Painel
          </a>
          <h1 class="font-serif text-2xl font-bold mt-1 text-ink">Jornal de {parsedPet.name}</h1>
        </div>
        <div class="bg-accent/10 border border-accent/25 text-accent px-4 py-2 rounded-xl text-xs font-bold uppercase tracking-wider">
          <i class="fa-solid fa-calendar-day mr-1"></i> Dia {currentJourneyDay} da Jornada
        </div>
      </div>

      <!-- THE NEWSPAPER (Replicating homepage style) -->
      <div class="newspaper-container border-double-thick p-4 sm:p-8 max-w-4xl mx-auto shadow-2xl relative bg-[#f4eadd] text-ink" id="newspaper-paper">
        
        <!-- Newspaper Header -->
        <header class="text-center mb-6">
          <div class="flex justify-between items-center border-y-newspaper py-2 mb-4">
            <div class="text-xs sm:text-sm font-bold uppercase w-1/3 text-left">
              <i class="fa-solid fa-cloud text-accent"></i> Edição Diária
            </div>
            <div class="text-xs sm:text-sm font-bold uppercase w-1/3 text-center tracking-widest text-accent">
              Amor Eterno
            </div>
            <div class="text-xs sm:text-sm font-bold uppercase w-1/3 text-right" id="newspaper-date">
              {formattedDate}
            </div>
          </div>

          <p class="font-serif text-3xl sm:text-5xl font-black uppercase tracking-tighter mb-2 text-ink" style="text-shadow: 2px 2px 0px rgba(0, 0, 0, 0.1)">
            Notícias do Céu
          </p>
          <p class="font-serif text-sm sm:text-base italic mb-4">
            O JORNAL DAS BOAS NOTÍCIAS E DAS HISTÓRIAS QUE AQUECEM O CORAÇÃO
          </p>

          <div class="border-y-newspaper py-1 mb-6 text-xs font-bold uppercase tracking-widest">
            DIRETAMENTE DO PARAÍSO PARA A TERRA • DISTRIBUIÇÃO EXCLUSIVA
          </div>
        </header>

        <!-- Main Content Grid -->
        <div class="grid grid-cols-1 md:grid-cols-12 gap-6">
          
          <!-- Left Column: Rotating Sidebars -->
          <div class="md:col-span-3 border-b-2 md:border-b-0 md:border-r-2 border-ink/30 pb-6 md:pb-0 md:pr-6">
            {news.sidebars.map((side, idx) => (
              <div class="text-center mb-6">
                <h5 class="font-serif font-bold text-lg uppercase mb-2 flex items-center justify-center gap-2">
                  <i class={`fa-solid ${side.icon} text-accent`}></i>
                  <span>{side.title}</span>
                </h5>
                <div class="text-sm italic font-body text-left md:text-justify text-ink/90">
                  "{side.content}"
                </div>
                {idx === 0 && <div class="separator-line"></div>}
              </div>
            ))}
          </div>

          <!-- Center Column: Main Story -->
          <div class="md:col-span-9">
            
            <!-- Headline block -->
            <div class="text-center mb-6">
              <h2 class="font-serif font-bold text-2xl sm:text-3xl uppercase leading-tight mb-3 text-ink">
                {news.headline}
              </h2>
              <h3 class="font-serif text-lg sm:text-xl font-medium italic text-gray-700 mb-4">
                {news.subheadline}
              </h3>
            </div>

            <!-- Content row -->
            <div class="flex flex-col sm:flex-row gap-6 items-start">
              
              <!-- Pet Image (Only shown if pet has photos) -->
              {selectedPhoto && (
                <div class="w-full sm:w-1/2 relative flex-shrink-0">
                  <div class="absolute -top-3 -left-3 text-4xl text-accent/80">
                    <i class="fa-solid fa-quote-left"></i>
                  </div>
                  <div class="border-4 border-white shadow-md transform -rotate-1 relative z-10 bg-white">
                    <img
                      src={selectedPhoto}
                      alt={parsedPet.name}
                      class="w-full h-auto max-h-[300px] object-cover filter grayscale contrast-[1.05]"
                    />
                    <div class="w-full bg-black/75 text-white text-[11px] p-1.5 text-center font-serif leading-tight">
                      {news.caption}
                    </div>
                  </div>
                </div>
              )}

              <!-- Story Paragraphs -->
              <div class={`w-full text-left md:text-justify font-body text-[15px] leading-relaxed text-ink/95 ${selectedPhoto ? 'sm:w-1/2' : 'columns-1 sm:columns-2 gap-6'}`}>
                <div set:html={news.text} />
              </div>

            </div>
          </div>
        </div>

        <!-- Footer of the newspaper -->
        <footer class="mt-8 pt-4 border-t-2 border-ink text-center">
          <p class="font-serif text-xs sm:text-sm font-bold uppercase tracking-widest flex items-center justify-center gap-4">
            <i class="fa-solid fa-star text-accent"></i>
            Porque o amor verdadeiro não tem fim
            <i class="fa-solid fa-star text-accent"></i>
          </p>
        </footer>
      </div>

      <!-- Action buttons & Testing Button under the newspaper -->
      <div class="mt-8 flex flex-col sm:flex-row justify-between items-center gap-4">
        <a
          href="/dashboard"
          class="bg-white text-ink border-2 border-ink px-8 py-3.5 rounded-full font-serif font-bold text-sm hover:bg-gray-50 transition-all shadow-md flex items-center gap-2 cursor-pointer"
        >
          <i class="fa-solid fa-arrow-left"></i> Voltar ao Painel
        </a>

        <!-- Test Button Form -->
        <form method="POST" class="w-full sm:w-auto">
          <input type="hidden" name="action" value="next-day" />
          <button
            type="submit"
            class="w-full sm:w-auto bg-amber-500 hover:bg-amber-600 text-white px-6 py-3.5 rounded-full font-sans font-bold text-xs uppercase tracking-wider shadow-md hover:shadow-lg transition-all flex justify-center items-center gap-2 cursor-pointer"
          >
            <i class="fa-solid fa-flask"></i> Simular Próximo Dia (Teste)
          </button>
        </form>
      </div>

    </div>
  </main>

  <Footer />
</Layout>
